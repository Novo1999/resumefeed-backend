# Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Morgan HTTP log format. Leave blank for: dev-friendly locally, combined in production.
# Any morgan format name (dev, combined, common, short, tiny) or a format string.
LOG_FORMAT=

# Supabase Postgres connection string
# Supabase Dashboard → Project Settings → Database → Connection string (URI)
DATABASE_URL=

# TypeORM
DB_SYNCHRONIZE=true
DB_LOGGING=false
DB_SSL=true

# Supabase (Project Settings → API) — for when you add auth/storage
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Storage bucket that holds resume PDFs (must match the frontend)
SUPABASE_RESUME_BUCKET=resumes
