# Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Morgan HTTP log format. Leave blank for: dev-friendly locally, combined in production.
# Any morgan format name (dev, combined, common, short, tiny) or a format string.
LOG_FORMAT=

# Supabase Postgres connection string
# Supabase Dashboard → Project Settings → Database → Connection string (URI)
DATABASE_URL=

# TypeORM
# Schema changes are applied by TypeORM migrations on startup.
# Only set this to true for a disposable local database.
DB_SYNCHRONIZE=false
DB_MIGRATIONS_RUN=true
DB_LOGGING=false
DB_SSL=true

# Supabase (Project Settings → API) — for when you add auth/storage
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Storage buckets (must match the frontend). Created by supabase/storage-setup.sql.
SUPABASE_RESUME_BUCKET=resumes
SUPABASE_AVATAR_BUCKET=avatars
